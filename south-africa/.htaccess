Options -Indexes

# sa-public-suspension-start
# Temporary public suspension for https://sa.gloriatrading.com/
# Existing pages, data, and the admin app stay in this directory.
# To publish the site again, remove this block and restore robots.txt
# and images/.htaccess. /admin/ stays on its own login.
DirectoryIndex site-suspended.html
ErrorDocument 403 /site-suspended.html

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

<FilesMatch "(?i)^(vehicles\.json|vehicle-feed\.php|vehicle-image\.php)$">
  Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^robots\.txt$ - [END]
RewriteRule ^site-suspended\.html$ - [END]
# Authenticated admin only. Public pages, data, and images stay suspended.
RewriteRule ^admin(?:/|$) - [END]
RewriteRule ^ /site-suspended.html [END]
# sa-public-suspension-end

# Preserved vehicle feed. Unreachable while the suspension rules above are active.
RewriteRule ^data/vehicles\.json$ data/vehicle-feed.php [L]
